<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        
        <PackageId>MadbyesGameLibrary</PackageId>
		<Version>0.2.0</Version>
		<Authors>madbye</Authors>
	  	<Company>madbye</Company>
		<Description>Madbye's Game Library</Description>
		<PackageProjectUrl>https://github.com/madbye/mgl/</PackageProjectUrl>
		<PackageTags>opengl;game;mgl</PackageTags>
    </PropertyGroup>
    

    <ItemGroup>
      <PackageReference Include="AssimpNet" Version="5.0.0-beta1" />
      <PackageReference Include="FontStashSharp" Version="1.3.9" />
      <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
      <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
      <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
      <PackageReference Include="StbImageSharp" Version="2.30.15" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Resources\Shaders\Phong\shader.frag" />
      <None Remove="data\shaders\phong\shader.vert" />
      <EmbeddedResource Include="Resources\Shaders\Phong\shader.vert" />
      <None Remove="data\shaders\text\shader.frag" />
      <EmbeddedResource Include="Resources\Shaders\Text\shader.frag" />
      <None Remove="data\shaders\text\shader.vert" />
      <EmbeddedResource Include="Resources\Shaders\Text\shader.vert" />
      <None Remove="data\shaders\blit\shader.frag" />
      <EmbeddedResource Include="Resources\Shaders\Blit\shader.frag" />
      <None Remove="data\shaders\blit\shader.vert" />
      <EmbeddedResource Include="Resources\Shaders\Blit\shader.vert" />
      <None Remove="data\shaders\PBR\shader.frag" />
      <EmbeddedResource Include="Resources\Shaders\PBR\shader.frag" />
      <None Remove="data\shaders\PBR\shader.vert" />
      <EmbeddedResource Include="Resources\Shaders\PBR\shader.vert" />
      <None Remove="Resources\Shaders\Unlit\shader.frag" />
      <EmbeddedResource Include="Resources\Shaders\Unlit\shader.frag" />
      <None Remove="Resources\Shaders\Unlit\shader.vert" />
      <EmbeddedResource Include="Resources\Shaders\Unlit\shader.vert" />
    </ItemGroup>
    
</Project>
